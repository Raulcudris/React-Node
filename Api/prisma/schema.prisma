generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  avatar    String?
  createdAt DateTime @default(now())

  posts      Post[]
  savedPosts SavedPost[]

  // Relación many-to-many con Chat mediante tabla puente
  chats      ChatUser[]
  seenChats  ChatSeen[]
  messages   Message[]
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  price     Int
  address   String
  city      String
  bedroom   Int
  bathroom  Int
  latitude  String
  longitude String
  type      Type
  property  Property
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  postDetail PostDetail?
  savedPosts SavedPost[]

  // En MySQL no hay String[] directo; lo normal es guardar JSON
  images Json
}

enum Type {
  buy
  rent
}

enum Property {
  apartment
  house
  condo
  land
}

model PostDetail {
  id         Int     @id @default(autoincrement())
  desc       String
  utilities  String?
  pet        String?
  income     String?
  size       Int?
  school     Int?
  bus        Int?
  restaurant Int?

  post   Post @relation(fields: [postId], references: [id])
  postId Int  @unique
}

model SavedPost {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  post   Post @relation(fields: [postId], references: [id])
  postId Int

  @@unique([userId, postId])
}

model Chat {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  lastMessage String?

  messages Message[]

  // Usuarios del chat (tabla puente)
  users  ChatUser[]
  // "seenBy" (tabla puente)
  seenBy ChatSeen[]
}

model Message {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())

  // Autor del mensaje
  user   User @relation(fields: [userId], references: [id])
  userId Int

  // Chat al que pertenece
  chat   Chat @relation(fields: [chatId], references: [id])
  chatId Int
}


model ChatUser {
  chat   Chat @relation(fields: [chatId], references: [id])
  chatId Int

  user   User @relation(fields: [userId], references: [id])
  userId Int

  @@id([chatId, userId])
}


model ChatSeen {
  chat   Chat @relation(fields: [chatId], references: [id])
  chatId Int

  user   User @relation(fields: [userId], references: [id])
  userId Int

  seenAt DateTime @default(now())

  @@id([chatId, userId])
}
